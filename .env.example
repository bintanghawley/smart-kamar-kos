# Konfigurasi Database PostgreSQL
POSTGRES_USER=smartkos
POSTGRES_PASSWORD=GantiDenganPasswordAman2026!
POSTGRES_DB=smartkos
DATABASE_URL=postgresql://smartkos:GantiDenganPasswordAman2026!@db:5432/smartkos

# Waktu & Zona Waktu (WIB)
TZ=Asia/Jakarta

# Pengaturan Interval Simpan Database (detik)
DB_TELEMETRY_INTERVAL_SEC=15
DB_RETENTION_DAYS=30

# Identifier dan Token Pengamanan Perangkat ESP32
# Kosongkan DEVICE_TOKEN jika belum ingin mengaktifkan autentikasi token
DEVICE_TOKEN=
DEFAULT_DEVICE_ID=esp32-kamar-01
